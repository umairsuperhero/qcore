{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/verify-fast.sh 2>&1 | head -120"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/fact-check-pr.sh 2>&1 | tail -120"
          }
        ]
      }
    ]
  }
}
